{
  "name": "ugent-monitor",
  "version": "0.1.0",
  "description": "Reports Codex session lifecycle events to UGENT for rate-limit-aware auto-resume.",
  "author": "Uni Zhu",
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "$PLUGIN_ROOT/hooks/on_session_start.sh",
            "statusMessage": "Reporting session start to UGENT"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "$PLUGIN_ROOT/hooks/on_user_prompt_submit.sh",
            "statusMessage": "Reporting user prompt to UGENT"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "$PLUGIN_ROOT/hooks/on_stop.sh",
            "statusMessage": "Reporting stop to UGENT"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "$PLUGIN_ROOT/hooks/on_post_tool_use.sh",
            "statusMessage": "Reporting tool use to UGENT"
          }
        ]
      }
    ]
  }
}
