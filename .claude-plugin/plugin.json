{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "ugent-monitor",
  "displayName": "UGENT Monitor",
  "version": "0.1.10",
  "description": "Reports Claude Code session lifecycle events to UGENT for rate-limit-aware auto-resume.",
  "author": {
    "name": "Uni Zhu",
    "url": "https://github.com/unizhu"
  },
  "homepage": "https://github.com/unizhu/ugent-monitor",
  "repository": "https://github.com/unizhu/ugent-monitor",
  "license": "MIT",
  "keywords": [
    "ugent",
    "monitor",
    "resume",
    "hooks",
    "mcp"
  ],
  "skills": "./skills/",
  "mcpServers": {
    "ugent-monitor": {
      "command": "python3",
      "args": [
        "-u",
        "${CLAUDE_PLUGIN_ROOT}/bin/ugent-monitor-mcp.py"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    }
  }
}
